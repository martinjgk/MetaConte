--- !u!114 &7304338509675399508
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3150484744326857616}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ee72b13f56920fe4aa51f24532301526, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  bookPanel: {fileID: 2839840860401198931}
  bookPanelCloseButton: {fileID: 3851852173021376482}
  buttonObject: {fileID: 0}
  QuestButtton: {fileID: 0}
  displayImage: {fileID: 1636099296993936057}
  displayText: {fileID: 937431690984226407}
  imageList:
  - {fileID: 21300000, guid: 1021dea62ba2ea24a94e32b4cd321284, type: 3}
  - {fileID: 21300000, guid: 935691736eee66f4886de9dd3ae59ce2, type: 3}
  - {fileID: 21300000, guid: 39dbdb381ce665441a534b9a8c0353e2, type: 3}
  - {fileID: 21300000, guid: 3adae95beec905d489f3b90355a9c233, type: 3}
  - {fileID: 21300000, guid: 0e833e5af5a7c814283af0d28060c59d, type: 3}
  - {fileID: 21300000, guid: 0e833e5af5a7c814283af0d28060c59d, type: 3}
  textList:
  - "<b>\uB9C8\uBC95 \uC774\uB984</b>: <b><color=#0080FF>\uBB3C</color></b>\n<b>\uB3D9\uC791
    \uC124\uBA85</b>: \n1. \uC624\uB978 \uC8FC\uBA39\uC758 \uC5C4\uC9C0\uC640 \uAC80\uC9C0\uB97C
    \uD3B4\uAE30.\n2. \uC5C4\uC9C0\uC640 \uAC80\uC9C0\uB97C \uAD6C\uBD80\uB9AC\uAE30\n3. 
    \uC785\uC73C\uB85C \uC57D\uAC04 \uAE30\uC6B8\uC5EC \uC62C\uB9AC\uAE30\n\uCEF5\uC744
    \uB4E4\uACE0 \uBB3C\uC744 \uB9C8\uC2DC\uB294 \uB3D9\uC791\uC744 \uB5A0\uC62C\uB9AC\uBA74
    \uC88B\uC544:) \n<b>\uC870\uD569 \uAC00\uB2A5\uD55C \uB9C8\uBC95</b>: \n\uBE44:
    \uBB3C + \uB0B4\uB9AC\uB2E4, \uAC15: \uBB3C + \uD750\uB974\uB2E4 "
  - "<b>\uB9C8\uBC95 \uC774\uB984</b>: \uB0B4\uB9AC\uB2E4\r\n<b>\uB3D9\uC791 \uC124\uBA85</b>:
    \n1. \uC190\uB05D\uC774 \uC544\uB798\uB85C \uC190\uB4F1\uC774 \uBC16\uC73C\uB85C
    \uD5A5\uD558\uAC8C \uD558\uAE30.\r\n2. \uB450 \uC190\uC744 \uC0C1\uD558\uB85C
    \uB450 \uBC88 \uC6C0\uC9C1\uC774\uAE30.\r\n<b>\uD604\uC7AC \uC870\uD569 \uAC00\uB2A5\uD55C
    \uB9C8\uBC95</b>: \r\n\uBE44: \uBB3C + \uB0B4\uB9AC\uB2E4 "
  - "<b>\uB9C8\uBC95 \uC774\uB984</b>: \uD750\uB974\uB2E4\r\n<b>\uB3D9\uC791 \uC124\uBA85</b>:
    \r\n1. \uC624\uB978\uC190\uC744 \uD3B4\uC11C \uC190\uBC14\uB2E5\uC774 \uC704\uB85C
    \uC190\uB05D\uC774 \uC67C\uCABD\uC73C\uB85C \uD5A5\uD558\uAC8C \uD558\uAE30\r\n2.
    \uC0C1\uD558\uB85C \uC57D\uAC04 \uD754\uB4E4\uBA70 \uC624\uB978\uCABD\uC73C\uB85C
    \uC774\uB3D9\uC2DC\uD0A4\uAE30\r\n<b>\uC870\uD569 \uAC00\uB2A5\uD55C \uB9C8\uBC95</b>:
    \r\n\uAC15: \uBB3C + \uD750\uB974\uB2E4\r\n\uD654\uC5FC: \uBD88 + \uD750\uB974\uB2E4"
  - "<b>\uB9C8\uBC95 \uC774\uB984</b>: <b><color=#DF0101>\uBD88</color></b>\r\n<b>\uB3D9\uC791
    \uC124\uBA85</b>: \n1. \uB450 \uC190\uC744 \uD3B4\uC11C \uC190\uB4F1\uC774 \uBC16\uC73C\uB85C
    \uBCF4\uC774\uAC8C \uD558\uAE30.\n2. \uC190\uB05D\uC774 \uC704\uB85C \uD5A5\uD558\uAC8C
    \uC138\uC6B0\uAE30.\r\n3. \uC190\uAC00\uB77D\uC744 \uAC00\uBCCD\uAC8C \uD754\uB4E4\uBA74\uC11C
    \uC0C1\uD558\uB85C \uC5C7\uAC08\uB9AC\uAC8C \uC6C0\uC9C1\uC774\uAE30.\r\n<b>\uC870\uD569
    \uAC00\uB2A5\uD55C \uB9C8\uBC95</b>: \r\n\uC720\uC131: \uBD88 + \uB0B4\uB9AC\uB2E4,
    \uD654\uC5FC: \uBD88 + \uD750\uB974\uB2E4\n\uBD88\uAF43\uD380\uCE58: \uBD88 +
    \uC8FC\uBA39"
  - "<b>\uB9C8\uBC95 \uC774\uB984</b>: \uC8FC\uBA39\r\n<b>\uB3D9\uC791 \uC124\uBA85</b>:
    \n1. \uC624\uB978\uC190\uC744 \uC8FC\uBA39\uC9C0\uACE0 \uAC80\uC9C0\uB9CC \uD3B4\uAE30.\r\n2.
    \uC190\uAC00\uB77D\uC758 \uB05D\uC744 \uC67C \uC8FC\uBA39\uC5D0 \uB300\uC5B4\uC8FC\uAE30.\r\n<b>\uC870\uD569
    \uAC00\uB2A5\uD55C \uB9C8\uBC95</b>: \r\n\uBB3C\uC8FC\uBA39: \uBB3C + \uC8FC\uBA39\r\n\uBD88\uC8FC\uBA39:
    \uBD88 + \uC8FC\uBA39"
  - "<b>\uB9C8\uBC95 \uC774\uB984</b>: \uC9C0\uC625\r\n<b>\uB3D9\uC791 \uC124\uBA85</b>:
    \n1. \uB450 \uC8FC\uBA39\uC758 \uAC80\uC9C0\uB97C \uD3B4\uC11C \uBC14\uB2E5\uC774
    \uBC16\uC73C\uB85C \uD5A5\uD558\uAC8C \uC138\uC6B0\uAE30.\r\n2. \uD131 \uC591\uC606\uC5D0
    \uB314\uB2E4\uAC00 \uBA38\uB9AC \uC591\uCABD\uC5D0 \uC62C\uB824 \uB300\uC5B4\uC62C\uB9AC\uAE30.
    \r\n3. \uC624\uB978 \uC8FC\uBA39\uC758 1\uC9C0\uB97C \uD3B4\uC11C \uB05D\uC774
    \uC544\uB798\uB85C \uD5A5\uD558\uAC8C \uD558\uC5EC \uB0B4\uB9AC\uAE30.\r\n<b>\uC870\uD569
    \uAC00\uB2A5\uD55C \uB9C8\uBC95</b>: \r\n\uBB3C\uC9C0\uC625: \uBB3C + \uC9C0\uC625\r\n\uBD88\uC9C0\uC625:
    \uBD88 + \uC9C0\uC625"
